SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CLIENT_ID=replace_with_dev_dashboard_client_id
SHOPIFY_CLIENT_SECRET=replace_with_dev_dashboard_client_secret
SHOPIFY_API_VERSION=2026-07
# Choose a long random secret; send it as X-API-Key from your trusted bot backend.
PRODUCT_BROWSING_API_KEY=replace_with_a_long_random_secret
# Optional only for legacy apps that still use a pre-generated Admin API token:
# SHOPIFY_ACCESS_TOKEN=shpat_replace_me

# WhatChimp Developer API (optional until product-card sending is used)
WHATCHIMP_API_TOKEN=your_whatchimp_api_token_here
WHATCHIMP_PHONE_NUMBER_ID=your_whatchimp_phone_number_id_here
WHATCHIMP_API_BASE_URL=https://app.whatchimp.com/api/v1
# Protect inbound requests from WhatChimp to our backend
WHATCHIMP_INBOUND_API_KEY=replace_with_a_long_random_secret

# Dedicated encrypted View Details button webhook; does not enable global incoming traffic.
WHATCHIMP_BUTTON_TOKEN_KEY=your_generated_fernet_key
# Optional comma-separated old Fernet keys for rotation (never commit real keys).
WHATCHIMP_BUTTON_TOKEN_PREVIOUS_KEYS=
# Optional field-path overrides if the provider uses a different payload structure.
WHATCHIMP_BUTTON_PHONE_PATH=
WHATCHIMP_BUTTON_SUBSCRIBER_PATH=
WHATCHIMP_BUTTON_EVENT_ID_PATH=
WHATCHIMP_BUTTON_RATE_LIMIT=30
# Optional reviews: source standard or judgeme_badge, enabled only after source verification.
WHATCHIMP_BUTTON_REVIEWS_VERIFIED=false
WHATCHIMP_BUTTON_REVIEW_SOURCE=standard
WHATCHIMP_BUTTON_REVIEWS_NAMESPACE=reviews
WHATCHIMP_BUTTON_RATING_KEY=rating
WHATCHIMP_BUTTON_REVIEW_COUNT_KEY=rating_count
